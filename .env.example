# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce?sslmode=disable

# JWT signing secrets: at least 32 characters each, and different from each other.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

PORT=8080
# "production" enables Secure cookies and HSTS (requires HTTPS)
ENV=development

# Comma-separated frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
